<Window x:Class="StudentPassportMonitor.Wpf.StudentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StudentPassportMonitor.Wpf"
        Title="Карточка студента" Width="640" Height="760" MinWidth="480" MinHeight="540" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" Language="ru-RU">
  <DockPanel Margin="22" Background="{StaticResource WindowBrush}" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Отмена" Width="110" IsCancel="True"/>
      <Button Content="Сохранить" Width="130" Background="{StaticResource AccentBrush}"
              Click="Save_Click" IsDefault="True"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource WindowBrush}" Padding="0,0,12,0">
      <StackPanel>
        <TextBlock Text="Данные студента" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <TextBlock Text="Фамилия *"/>
        <TextBox x:Name="LastNameBox" Margin="0,5,0,12"/>
        <TextBlock Text="Имя *"/>
        <TextBox x:Name="FirstNameBox" Margin="0,5,0,12"/>
        <TextBlock Text="Отчество"/>
        <TextBox x:Name="MiddleNameBox" Margin="0,5,0,12"/>
        <TextBlock Text="Группа"/>
        <TextBox x:Name="GroupBox" Margin="0,5,0,12"/>
        <TextBlock Text="Факультет"/>
        <TextBox x:Name="FacultyBox" Margin="0,5,0,12"/>
        <TextBlock Text="Дата рождения"/>
        <local:DarkDatePicker x:Name="BirthDatePicker" Margin="0,5,0,12"/>
        <TextBlock Text="Статус обучения"/>
        <ComboBox x:Name="StatusBox" IsEditable="True" Margin="0,5,0,12">
          <ComboBoxItem Content="Учащийся"/>
          <ComboBoxItem Content="Академический отпуск"/>
          <ComboBoxItem Content="Отчислен"/>
          <ComboBoxItem Content="Выпускник"/>
        </ComboBox>
        <Separator Margin="0,12"/>
        <TextBlock Text="Паспортные сведения" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <TextBlock Text="Серия и номер"/>
        <TextBox x:Name="PassportNumberBox" Margin="0,5,0,12"/>
        <TextBlock Text="Кем выдан"/>
        <TextBox x:Name="IssuedByBox" Margin="0,5,0,12"/>
        <TextBlock Text="Дата выдачи"/>
        <local:DarkDatePicker x:Name="IssueDatePicker" Margin="0,5,0,12"/>
        <TextBlock Text="Дата последней замены"/>
        <local:DarkDatePicker x:Name="ReplacementDatePicker" Margin="0,5,0,12"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>