<Window x:Class="StudentPassportMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Passport Monitor — 2.0.0" Width="1320" Height="820"
        MinWidth="880" MinHeight="580" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" Language="ru-RU">
  <Window.Resources>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,24">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="◈  PASSPORT" FontSize="22" FontWeight="Bold" Foreground="White" Margin="12,0,0,3"/>
          <TextBlock Text="MONITOR   /   v2.0.0" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,34"/>
          <Button Content="◫   Обзор" Style="{StaticResource NavigationButton}" Click="Dashboard_Click"/>
          <Button Content="♙   Студенты" Style="{StaticResource NavigationButton}" Click="Students_Click"/>
          <Button Content="♧   Уведомления" Style="{StaticResource NavigationButton}" Click="Notifications_Click"/>
          <Button Content="▥   Отчёты" Style="{StaticResource NavigationButton}" Click="Reports_Click"/>
          <Button Content="◷   История проверок" Style="{StaticResource NavigationButton}" Click="History_Click"/>
          <Button Content="⚙   Настройки" Style="{StaticResource NavigationButton}" Click="Settings_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>
          <TextBlock x:Name="SidebarStatus" Text="●  База загружена" Foreground="#7AD7A1" Margin="10,0,0,8"/>
          <TextBlock Text="Данные хранятся локально" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="22,22,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,25">
        <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="STUDENT PASSPORT MONITOR" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="15,0,0,0"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid x:Name="DashboardPage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource CardStyle}" Cursor="Hand" MouseLeftButtonUp="DashboardAll_Click" ToolTip="Открыть список студентов">
              <StackPanel>
                <TextBlock Text="Всего студентов" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TotalValue" Text="0" FontSize="38" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBlock Text="Открыть список →" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Cursor="Hand" MouseLeftButtonUp="DashboardAttention_Click" ToolTip="Показать записи, требующие внимания">
              <StackPanel>
                <TextBlock Text="Скоро контрольная дата" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="UpcomingValue" Text="0" FontSize="38" FontWeight="Bold" Foreground="#F5B768" Margin="0,10,0,0"/>
                <TextBlock Text="Перейти к уведомлениям →" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Cursor="Hand" MouseLeftButtonUp="DashboardAttention_Click" ToolTip="Показать записи, требующие проверки">
              <StackPanel>
                <TextBlock Text="Требуют проверки" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ReviewValue" Text="0" FontSize="38" FontWeight="Bold" Foreground="#ED8C93" Margin="0,10,0,0"/>
                <TextBlock Text="Перейти к уведомлениям →" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Проверить сейчас" Style="{StaticResource AccentButton}"
                      Click="CheckNow_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Text="Контроль паспортных данных" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="LastCheckValue" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Все уведомления" Click="DashboardAttentionButton_Click"
                        Margin="12,0,0,0"/>
                <StackPanel>
                  <TextBlock Text="Ближайшие события" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DashboardAttentionSummary" Foreground="{StaticResource MutedBrush}"
                             Margin="0,4,0,0" Text="Нет событий, требующих внимания"/>
                </StackPanel>
              </DockPanel>
              <DataGrid x:Name="DashboardAttentionGrid" Grid.Row="1" AutoGenerateColumns="False"
                        IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                        MouseDoubleClick="DashboardAttentionGrid_DoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Студент" Binding="{Binding FullName}" Width="2*"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Группа" Binding="{Binding Group}" Width="*"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Контрольная дата" Binding="{Binding DueDate}" Width="*"/>
                  <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Состояние" Binding="{Binding State}" Width="2*"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="2" Text="Двойной щелчок по записи открывает карточку студента"
                         Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="StudentsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,14">
            <Button Content="+  Добавить" Style="{StaticResource AccentButton}" Click="AddStudent_Click"/>
            <Button Content="Изменить" Click="EditStudent_Click"/>
            <Button Content="Удалить" Click="DeleteStudent_Click"/>
            <Button Content="Импорт Excel" Click="Import_Click"/>
            <Button Content="Экспорт Excel" Click="Export_Click"/>
          </WrapPanel>
          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" ToolTip="Поиск по ФИО" TextChanged="Filter_Changed" Margin="0,0,12,0"/>
            <ComboBox x:Name="GroupFilter" Grid.Column="1" SelectionChanged="Filter_Changed" Margin="0,0,12,0"/>
            <CheckBox x:Name="AttentionFilter" Grid.Column="2" Content="Требуют внимания" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
          </Grid>
          <DataGrid x:Name="StudentsGrid" Grid.Row="2" SelectionMode="Single" MouseDoubleClick="StudentsGrid_DoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
              <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Группа" Binding="{Binding Group}"/>
              <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Факультет" Binding="{Binding Faculty}"/>
              <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Дата рождения" Binding="{Binding BirthDate}"/>
              <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Возраст" Binding="{Binding Age}" Width="75"/>
              <DataGridTextColumn ElementStyle="{StaticResource CenteredDataGridText}" Header="Контрольная дата" Binding="{Binding DueDate}"/>
              <DataGridTemplateColumn Header="Состояние" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border x:Name="StatusBadge" Background="#343748" CornerRadius="7"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,6" Margin="4,2">
                      <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Требуется проверка паспорта">
                        <Setter TargetName="StatusBadge" Property="Background" Value="#70383F"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Рубеж наступил — проверьте замену">
                        <Setter TargetName="StatusBadge" Property="Background" Value="#77512B"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Замена подтверждена">
                        <Setter TargetName="StatusBadge" Property="Background" Value="#285847"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Нет даты рождения">
                        <Setter TargetName="StatusBadge" Property="Background" Value="#565166"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <Grid x:Name="NotificationsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Контрольные даты паспортов. Отметка проверки не подтверждает замену документа."
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
            <WrapPanel>
              <Button Content="Обновить" Click="Refresh_Click"/>
              <Button Content="Открыть карточку" Click="OpenAttention_Click"/>
              <Button Content="Отметить проверенным" Style="{StaticResource AccentButton}" Click="MarkReviewed_Click"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="AttentionGrid" Grid.Row="1" MouseDoubleClick="AttentionGrid_DoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Студент" Binding="{Binding FullName}" Width="2*"/>
              <DataGridTextColumn Header="Группа" Binding="{Binding Group}"/>
              <DataGridTextColumn Header="Контрольная дата" Binding="{Binding DueDate}"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="2*"/>
              <DataGridTextColumn Header="Последняя проверка" Binding="{Binding Reviewed}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <Grid x:Name="ReportsPage" Visibility="Collapsed">
          <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Экспорт отчётов" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Выберите тип отчёта. Файл сохраняется в формате XLSX."
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,0,15"/>
              <ComboBox x:Name="ReportType" SelectedIndex="0" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14">
                <ComboBoxItem Content="Все студенты"/>
                <ComboBoxItem Content="Требуют внимания"/>
                <ComboBoxItem Content="По группе"/>
                <ComboBoxItem Content="Неполные сведения"/>
              </ComboBox>
              <ComboBox x:Name="ReportGroup" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14"/>
              <Button Content="Сохранить отчёт Excel" Style="{StaticResource AccentButton}"
                      HorizontalAlignment="Left" Click="Export_Click"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="HistoryPage" Visibility="Collapsed">
          <DataGrid x:Name="HistoryGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Дата и время" Binding="{Binding CheckedAt}" Width="2*"/>
              <DataGridTextColumn Header="Запуск" Binding="{Binding Mode}"/>
              <DataGridTextColumn Header="Требуют внимания" Binding="{Binding Count}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Настройки мониторинга" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <TextBlock Text="Предупреждать за (дней):" Margin="0,0,0,8"/>
              <TextBox x:Name="WarningDaysBox" Width="120" HorizontalAlignment="Left" Margin="0,0,0,15"/>
              <CheckBox x:Name="StartupCheck" Content="Запускать вместе с Windows" Margin="0,0,0,18"/>
              <WrapPanel>
                <Button Content="Сохранить настройки" Style="{StaticResource AccentButton}" Click="SaveSettings_Click"/>
                <Button Content="Восстановить базу" Click="RestoreBackup_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,15,0,0">
        <TextBlock x:Name="FooterStatus" Foreground="{StaticResource MutedBrush}" Text="Загрузка данных..."/>
      </Border>
    </Grid>
  </Grid>
</Window>