    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StudentPassportMonitor</RootNamespace>
    <AssemblyName>StudentPassportMonitor</AssemblyName>
